# Conexión a la base. Por defecto usa SQLite (cero configuración); para usar
# Postgres, comentar esta línea y descomentar la de abajo con tus credenciales.
DATABASE_URL=sqlite:///./foodstore.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# Firma del JWT: cambiar por una clave propia de al menos 32 caracteres.
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen permitido en CORS (el frontend de Vite).
FRONTEND_ORIGIN=http://localhost:5173
